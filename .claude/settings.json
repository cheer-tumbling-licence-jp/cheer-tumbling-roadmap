{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/hooks/after_edit.sh\"",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/hooks/before_report.sh\"",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(bash scripts/check_before_report.sh)",
      "Bash(bash scripts/check_before_report.sh:*)",
      "Bash(ALLOW_SKILLS_EDIT=1 bash scripts/check_before_report.sh)",
      "Bash(git diff:*)",
      "Bash(git status:*)"
    ]
  }
}
