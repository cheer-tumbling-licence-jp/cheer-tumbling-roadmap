rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // users コレクション
    // - read: 招待コード解決のため認証なしで許可（含まれる情報は最小限：email, displayName, role, teamName, inviteCode）
    // - create: 自分のドキュメントのみ
    // - update: 自分のドキュメント、または所属選手のドキュメントをそのコーチが更新（所属解除など）
    // - delete: 自分のドキュメント、または所属選手のドキュメントをそのコーチが削除（完全削除機能）
    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null
                    && (request.auth.uid == userId
                        || resource.data.coachId == request.auth.uid);
      allow delete: if request.auth != null
                    && (request.auth.uid == userId
                        || resource.data.coachId == request.auth.uid);
    }

    // assignments コレクション (v1.1 本格実装)
    // - read: ログイン中なら可能（選手は自分宛か全体宛をクライアント側でフィルタ）
    // - create: コーチが自分の coachId で作成
    // - update/delete: 作成したコーチのみ
    match /assignments/{assignmentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.coachId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.coachId == request.auth.uid;
    }

    // submissions コレクション (v1.1 本格実装、動画提出含む)
    // - read: 関係者（提出した選手 or 担当コーチ）のみ
    // - create: 選手が自分の studentId で作成
    // - update: 提出本人 or コーチがコメント付与時
    // - delete: 提出本人 or 担当コーチ（選手データ完全削除時に使用）
    match /submissions/{submissionId} {
      allow read: if request.auth != null
                  && (resource.data.studentId == request.auth.uid
                      || resource.data.coachId == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.studentId == request.auth.uid;
      allow update: if request.auth != null
                    && (resource.data.studentId == request.auth.uid
                        || resource.data.coachId == request.auth.uid);
      allow delete: if request.auth != null
                    && (resource.data.studentId == request.auth.uid
                        || resource.data.coachId == request.auth.uid);
    }

    // bug_reports コレクション（実地テスト用の不具合報告）
    // - create: 誰でも可（未ログインユーザーからも報告できるように）
    // - read/update/delete: 一般ユーザーは禁止（管理者は Console / CLI 経由）
    match /bug_reports/{reportId} {
      allow create: if true;
      allow read, update, delete: if false;
    }
  }
}
